  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.58.2",
    "@types/node": "^22.20.1",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  },
  "overrides": {
    "playwright-core": "1.58.2"
  },
  "engines": {
    "node": ">=20"
  }
}
